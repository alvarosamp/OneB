{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "VITE_API_URL= npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://oneb-api.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://oneb-api.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
