# URL do backend (API FastAPI). Em produção, aponta pro serviço backend no Render.
# Fica "embutida" no build (Vite lê isso em build time, não em runtime) — então
# precisa estar setada ANTES de rodar `npm run build`.
VITE_API_URL=http://localhost:8000

# E-mail de contato exibido nos Termos de uso e na Política de Privacidade (também em build time).
VITE_CONTACT_EMAIL=
