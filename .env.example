# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do arquivo .env (contém segredos).

# Finnhub (grátis em https://finnhub.io/register) - usado para cotações, notícias e earnings
FINNHUB_API_KEY=

# Fonte de candles OHLCV. Use "yfinance" para desenvolvimento grátis/fallback.
# Use "tiingo" para pesquisa/backtests EOD com OHLCV ajustado por splits/dividendos.
MARKET_DATA_PROVIDER=yfinance
TIINGO_API_KEY=

# Financial Modeling Prep (grátis em https://financialmodelingprep.com/developer/docs/)
# usado só para o calendário econômico (juros, payroll, inflação etc.)
FMP_API_KEY=

# FRED - Federal Reserve Economic Data (grátis, sem cartão, em
# https://fred.stlouisfed.org/docs/api/api_key.html) - fonte oficial usada pelo regime
# engine para yields do Tesouro (2/5/10/30 anos), dollar index e VIX, em vez de proxies
# via Yahoo. Sem essa key, esses instrumentos ficam indisponíveis no /api/regime/macro.
FRED_API_KEY=

# Telegram - crie um bot com @BotFather no Telegram e pegue o token
TELEGRAM_BOT_TOKEN=
# Envie /start para o seu bot, depois rode `python get_chat_id.py` (veja README)
# para descobrir o TELEGRAM_CHAT_ID e cole aqui. Só esse chat_id poderá usar o bot.
TELEGRAM_CHAT_ID=
# O bot do Telegram não tem login próprio — ele age em nome de uma conta específica do
# dashboard (watchlist, posições, resumo diário, análise matinal são dela). Coloque aqui o
# username dessa conta. Vazio = usa o primeiro admin cadastrado.
TELEGRAM_ACTS_AS_USERNAME=

# Login da API (tokens JWT, ver app/auth.py). Gere com:
# python -c "import secrets; print(secrets.token_hex(32))"
# OBRIGATÓRIO em produção - o boot falha se ela estiver vazia.
SECRET_KEY=
# Access token curto + refresh token revogável em cookie httpOnly.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=oneb_refresh

# CORS - URL do front-end (React separado). Em produção, é a URL do site estático no Render.
FRONTEND_ORIGIN=http://localhost:5173


# --- PostgreSQL (producao, docker-compose.prod.yml) ---------------------------------
# Em desenvolvimento o padrao continua SQLite. Em producao, API/worker/simulator
# escrevem no mesmo banco e o SQLite serializa escritas (um writer por vez), entao o
# compose de producao sobe PostgreSQL e aplica o schema via `alembic upgrade head`.
POSTGRES_USER=oneb
POSTGRES_PASSWORD=
POSTGRES_DB=oneb

# Banco de dados (SQLite por padrão, funciona out-of-the-box)
DATABASE_URL=sqlite:///./nasdaq_monitor.db

# Frequência de polling (em segundos)
QUOTE_POLL_SECONDS=60
INDICATOR_REFRESH_SECONDS=300
DAILY_SUMMARY_HOUR_UTC=21
NEWS_REFRESH_SECONDS=1800
CALENDAR_REFRESH_HOUR_UTC=6
MACRO_INTELLIGENCE_HOUR_UTC=23
RADAR_BOT_HOUR_UTC=13
WEEKLY_REVIEW_BOT_DAY_OF_WEEK=fri
WEEKLY_REVIEW_BOT_HOUR_UTC=20
# true mantém API+scheduler juntos para execução simples; no docker-compose separado fica false na API.
RUN_EMBEDDED_SCHEDULER=true

# Assistente com IA - opcional: sem chave configurada, o sistema funciona normal
# (resumo diário em formato simples, assistente avisa que está desativado).
#
# LLM_PROVIDER escolhe qual API usar:
#   "groq"      -> grátis, sem cartão de crédito, modelos Llama bem rápidos
#                  (crie a key em https://console.groq.com/keys)
#   "gemini"    -> grátis, sem cartão de crédito
#                  (crie a key em https://aistudio.google.com/apikey)
#   "anthropic" -> pago (créditos pré-pagos), recomendado pra produção
#                  (crie a key em https://console.anthropic.com)
LLM_PROVIDER=groq

# Usado só se LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Usado só se LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Usado só se LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Resumo diário narrativo (em vez de só lista de números) - true/false
LLM_DAILY_NARRATIVE_ENABLED=true
# Adiciona uma frase de contexto de IA em CADA alerta disparado - desligado por padrão
# porque alertas podem disparar com frequência e cada um vira uma chamada de API.
LLM_ENRICH_ALERTS=false

# --- Ambiente e seguranca da sessao -------------------------------------------------
# "development" (padrao) ou "production". Em production, SECRET_KEY ausente DERRUBA o
# boot (em vez de gerar uma chave temporaria que invalida todas as sessoes a cada
# restart e diverge entre replicas), e o cookie de sessao passa a ser marcado Secure.
ENVIRONMENT=development

# Admin inicial. Cadastro publico NUNCA cria admin (antes, o primeiro a se cadastrar
# virava administrador -- quem chegasse primeiro num deploy novo ganhava controle total).
# Preencha estas duas variaveis para que esse usuario seja criado como admin no startup,
# somente enquanto o banco nao tiver nenhum usuario. Depois disso, promova outros com:
#   python -m scripts.promote_admin <usuario>
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
