# Copie para .env.production no servidor e substitua todos os valores CHANGE_ME.
# Nunca envie o .env.production real ao Git.

ENVIRONMENT=production
APP_VERSION=latest
# Dominio sem https://; o registro A deve apontar para o IP publico da VPS.
DOMAIN=app.seu-dominio.com
FRONTEND_ORIGIN=https://app.seu-dominio.com

POSTGRES_USER=oneb
# Use somente letras e numeros, pois este valor tambem compoe a DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
POSTGRES_DB=oneb

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=oneb_refresh

# Primeiro administrador; remova estas credenciais depois do primeiro boot bem-sucedido.
ADMIN_BOOTSTRAP_USERNAME=CHANGE_ME_ADMIN
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

FINNHUB_API_KEY=
TIINGO_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
MARKET_DATA_PROVIDER=yfinance

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ACTS_AS_USERNAME=

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_DAILY_NARRATIVE_ENABLED=true
LLM_ENRICH_ALERTS=false

QUOTE_POLL_SECONDS=60
INDICATOR_REFRESH_SECONDS=300
NEWS_REFRESH_SECONDS=1800
GLOBAL_NEWS_REFRESH_SECONDS=900
MACRO_REFRESH_SECONDS=900

# Horarios em UTC dos jobs agendados.
DAILY_SUMMARY_HOUR_UTC=21
MORNING_REPORT_HOUR_UTC=11
CALENDAR_REFRESH_HOUR_UTC=6
MACRO_INTELLIGENCE_HOUR_UTC=23
RADAR_BOT_HOUR_UTC=13
WEEKLY_REVIEW_BOT_DAY_OF_WEEK=fri
WEEKLY_REVIEW_BOT_HOUR_UTC=20

# Simulador de carteira (nao envia ordens reais).
PAPER_SIM_INTERVAL_SECONDS=300
PAPER_SIM_INITIAL_CAPITAL=50000
PAPER_SIM_MAX_POSITION_PCT=0.20
PAPER_SIM_MAX_OPEN_POSITIONS=5
PAPER_SIM_RELIABLE_PRECISION_PCT=70
PAPER_SIM_AI_FIRST_MODE=true
PAPER_SIM_AI_FIRST_MIN_PRECISION_PCT=45
